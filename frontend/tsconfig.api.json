{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Matches Vercel's own build-time check for api/ functions: relative
       ESM imports must be fully specified (a .js extension resolving to
       the .ts source), the same as tsconfig.node.json already requires
       for vite.config.ts. Deliberately not `moduleResolution: bundler` —
       that mode doesn't require extensions, which is exactly how the
       first version of this file passed locally while still failing
       Vercel's real build-time type-check. */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
